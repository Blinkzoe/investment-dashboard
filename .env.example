# ==========================================
# Investment Dashboard
# Environment template
# ==========================================

# PostgreSQL
POSTGRES_DB=investments
POSTGRES_USER=investments
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Backend
DATABASE_URL=postgresql+psycopg://investments:CHANGE_ME_TO_A_STRONG_PASSWORD@postgres:5432/investments

# Application
APP_ENV=development
APP_NAME=Investment Dashboard
LOG_LEVEL=INFO

# Security
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
